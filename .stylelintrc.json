{
	"extends": "stylelint-config-recommended",
	"ignoreFiles": [
		"addon/**",
		"node_modules/**",
		"vendor/**",
		"view/asset/**",
		"view/theme/frio/frameworks/**",
		"**/*.min.css",
		"**/*.min.*.css",
		"view/fonts/**",
		"view/js/fancybox/**",
		"view/js/friendica-tagsinput/**",
		"view/js/videojs/**",
		"view/theme/frio/css/font-awesome.custom.css",
		"view/theme/frio/font/**",
		"view/theme/vier/css/remixicon-vier.css"
	],
	"rules": {
		"no-descending-specificity": null,

		"declaration-property-value-no-unknown": [true, {
			"ignoreProperties": {
				"display": ["/^-(ms|moz|webkit)-/"]
			}
		}],

		"selector-type-no-unknown": [true, {
			"ignoreTypes": ["right_aside"],
			"severity": "warning"
		}],

		"font-family-no-missing-generic-family-keyword": [true, {
			"ignoreFontFamilies": ["remixicon"],
			"severity": "warning"
		}],

		"declaration-block-no-duplicate-properties": [true, {
			"ignore": ["consecutive-duplicates-with-different-values"],
			"severity": "warning"
		}],

		"no-duplicate-selectors": [true, { "severity": "warning" }],
		"declaration-property-value-keyword-no-deprecated": [true, { "severity": "warning" }],
		"property-no-deprecated": [true, { "severity": "warning" }],
		"block-no-empty": [true, { "severity": "warning" }]
	},
	"overrides": [
		{
			"files": [
				"view/theme/frio/css/*.css",
				"view/theme/frio/scheme/*.css"
			],
			"rules": {
				"declaration-property-value-no-unknown": null
			}
		}
	]
}
